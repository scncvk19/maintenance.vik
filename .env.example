# Start.ps1 / start.sh erzeugen automatisch ein zufälliges Datenbankpasswort.
POSTGRES_PASSWORD=
APP_PORT=3000

# Telegram bleibt ohne ausdrückliche Aktivierung deaktiviert.
TELEGRAM_BOT_TOKEN=
TELEGRAM_SEND_ENABLED=no
# Automatische Prüfung mindestens alle 300 Sekunden; Standard: stündlich.
TELEGRAM_CHECK_INTERVAL_SECONDS=3600
